# 감시할 폴더 (여기에 영상을 넣으면 자동으로 처리됩니다)
WATCH_FOLDER=./input

# 하이라이트 결과가 저장될 폴더
OUTPUT_FOLDER=./output

# 처리 완료된 원본 영상이 이동될 폴더
PROCESSED_FOLDER=./processed

# 하이라이트 하나의 길이(초)
HIGHLIGHT_DURATION_SEC=30

# 영상 하나당 뽑아낼 하이라이트 개수
HIGHLIGHT_COUNT=1

# 처리 대상으로 인식할 영상 확장자
VIDEO_EXTENSIONS=.mp4,.mov,.mkv,.avi

# 파일 쓰기가 끝났다고 판단하기까지 대기 시간(ms) - 복사/다운로드 중인 파일을 건너뛰기 위함
STABLE_CHECK_INTERVAL_MS=2000
